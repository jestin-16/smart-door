# ==============================================================================
# SmartDoorLight — Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env on your deployment host: cp .env.example .env
# 2. Replace all placeholder passwords with cryptographically strong secrets.
# 3. NEVER commit .env or secrets to version control.
# ==============================================================================

# PostgreSQL 16 Database Configuration
POSTGRES_DB=smartdoor_db
POSTGRES_USER=smartdoor_user
POSTGRES_PASSWORD=replace_with_strong_db_password

# Eclipse Mosquitto MQTT Broker Authentication
MQTT_BACKEND_USER=smartdoor_backend
MQTT_BACKEND_PASSWORD=replace_with_strong_backend_mqtt_pass
MQTT_ESP32_USER=smartdoor_esp32
MQTT_ESP32_PASSWORD=replace_with_strong_esp32_mqtt_pass

# Host Port Mappings (Public Ports)
# Only HTTP and MQTT are exposed publicly. PostgreSQL port 5432 is strictly internal!
HTTP_PORT=80
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# Backend & Frontend Networking
# In production behind Nginx reverse proxy, relative /api/v1 avoids CORS and hardcoded IPs.
VITE_API_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://15.252.238.128,http://localhost:5173,http://localhost:3000

# JVM Memory Management for AWS EC2 t3.small (2 GiB RAM)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=40.0 -Xmx384m -Xms128m
