#pragma once

#ifndef SMARTDOOR_SECRETS_H
#define SMARTDOOR_SECRETS_H

// ==============================================================================
// SmartDoorLight — ESP32 Firmware Secrets Configuration Template
// Copy this file to "secrets.h" in the same directory and enter credentials.
// NEVER commit secrets.h to version control!
// Security Notice: Any credentials compiled into ESP32 firmware can potentially
// be extracted from physical device flash memory. Keep production keys scoped!
// ==============================================================================

// 1. Wi-Fi Access Point (2.4 GHz only; ESP32 does not support 5 GHz)
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// 2. MQTT Broker Connectivity
// For Local Dev: "192.168.1.x", port 1883, MQTT_USE_TLS false
// For Deployed EC2: "15.252.238.128", port 8883 (MQTTS TLS) or 1883 (TCP)
#define MQTT_BROKER_HOST "15.252.238.128"
#define MQTT_BROKER_PORT 1883
#define MQTT_USE_TLS false

// 3. MQTT Authentication (must match Mosquitto password_file & acl_file)
#define MQTT_USER "smartdoor_esp32"
#define MQTT_PASSWORD "YOUR_ESP32_MQTT_PASSWORD"

// 4. Optional: Embed Root CA PEM Certificate for Strict TLS Verification
// If set to nullptr when MQTT_USE_TLS is true, ESP32 will connect with encrypted TLS (insecure mode for direct IP)
#define MQTT_CA_CERT nullptr

#endif // SMARTDOOR_SECRETS_H
