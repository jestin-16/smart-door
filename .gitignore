# Git ignore file for SmartDoorLight

# Credentials & secrets
secrets.h
*.env
.env
.env.*
!.env.example
*.pem
*.key
*.csr
*.crt
*.srl
!*.gitkeep

# Mosquitto certificates and dynamic configs
infrastructure/mosquitto/certs/*
!infrastructure/mosquitto/certs/.gitkeep
infrastructure/mosquitto/config/conf.d/*.conf
!infrastructure/mosquitto/config/conf.d/tls.conf.example
!infrastructure/mosquitto/config/conf.d/.gitkeep

# Firmware build artifacts
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local

# Java & Backend
target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar

# IDE & OS
.idea/
*.iml
.DS_Store
Thumbs.db
